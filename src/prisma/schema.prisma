datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Shoe {
  id          String   @id @default(cuid())
  name        String
  brand       String
  price       Float
  description String
  image       String
  category    String
  createdAt   DateTime @default(now())
}